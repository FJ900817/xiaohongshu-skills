{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/xhs/contracts/learning-review.schema.json",
  "title": "Learning Review Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "writing_id", "revision", "observed_changes", "repeated_patterns", "evidence", "suggested_rules", "suggested_adapter_changes", "confidence", "scope", "approval_required", "status", "synthetic"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_id": {"type": "string", "minLength": 1},
    "writing_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "observed_changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "change_kind", "before", "after", "evidence_refs"], "properties": {"field": {"type": "string", "minLength": 1}, "change_kind": {"enum": ["added", "removed", "revised"]}, "before": {"type": ["string", "null"]}, "after": {"type": ["string", "null"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}},
    "repeated_patterns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["pattern_id", "summary", "occurrences", "evidence_refs", "confidence"], "properties": {"pattern_id": {"type": "string"}, "summary": {"type": "string"}, "occurrences": {"type": "integer", "minimum": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "summary", "source_ref"], "properties": {"evidence_id": {"type": "string"}, "kind": {"enum": ["text_diff", "user_feedback", "revision_history", "visual_qa"]}, "summary": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}}}},
    "suggested_rules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "category", "scope", "proposal", "rationale", "evidence_refs", "confidence", "status"], "properties": {"proposal_id": {"type": "string"}, "category": {"enum": ["core_rule_candidate", "account_adapter_candidate", "one_off_preference"]}, "scope": {"enum": ["core", "adapter", "one_off"]}, "proposal": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"const": "proposal"}}}},
    "suggested_adapter_changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "profile_ref", "proposal", "evidence_refs", "confidence", "status"], "properties": {"proposal_id": {"type": "string"}, "profile_ref": {"type": ["string", "null"]}, "proposal": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"const": "proposal"}}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "scope": {"enum": ["core", "adapter", "one_off", "mixed"]},
    "approval_required": {"const": true},
    "status": {"const": "proposed"},
    "synthetic": {"type": "boolean"}
  }
}
