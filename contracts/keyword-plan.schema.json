{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/xhs/contracts/keyword-plan.schema.json",
  "title": "Keyword Plan Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "task_id", "status", "keywords", "approval"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "plan_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "approved", "rejected"]},
    "keywords": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["keyword_id", "phrase", "intent", "priority", "source", "evidence", "status", "role", "placement", "occurrence_rule", "topic_tag_mapping", "approval_state"], "properties": {
      "keyword_id": {"type": "string", "minLength": 1}, "phrase": {"type": "string", "minLength": 1}, "intent": {"type": "string", "minLength": 1},
      "level": {"type": ["integer", "null"], "minimum": 1}, "priority": {"type": "integer", "minimum": 1},
      "source": {"type": "object", "additionalProperties": false, "required": ["kind", "label"], "properties": {"kind": {"enum": ["user", "synthetic_catalog", "public_source", "model_suggestion", "unknown"]}, "label": {"type": "string"}, "uri": {"type": ["string", "null"]}}},
      "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["summary", "synthetic"], "properties": {"summary": {"type": "string"}, "synthetic": {"type": "boolean"}, "observed_at": {"type": ["string", "null"], "format": "date-time"}}}},
      "status": {"enum": ["candidate", "selected", "locked", "rejected"]}, "role": {"enum": ["main", "secondary"]},
      "placement": {"type": "array", "uniqueItems": true, "items": {"enum": ["title", "body", "topic", "tag"]}},
      "occurrence_rule": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["natural", "minimum", "maximum", "range", "avoid"]}, "min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}, "note": {"type": "string"}}},
      "topic_tag_mapping": {"type": "array", "items": {"type": "string"}}, "approval_state": {"enum": ["pending", "approved", "rejected"]}
    }}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"enum": ["pending", "approved", "rejected"]}, "approved_by": {"type": ["string", "null"]}, "approved_at": {"type": ["string", "null"], "format": "date-time"}}}
  },
  "$comment": "Semantic gate: at most one keyword may have role=main; writing consumes approved items and must not change roles or phrases."
}

