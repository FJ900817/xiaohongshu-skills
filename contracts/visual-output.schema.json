{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/xhs/contracts/visual-output.schema.json",
  "title": "Visual Output Contract V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "content_ref", "visual_plan", "pages", "image_tasks", "assets", "render_outputs", "qa_result", "production_manifest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "content_ref": {"type": "object", "additionalProperties": false, "required": ["writing_id", "revision", "status", "body_sha256"], "properties": {"writing_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "status": {"const": "approved"}, "body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "visual_plan": {"type": "object", "additionalProperties": false, "required": ["content_type", "page_count", "canvas", "style_preset"], "properties": {"content_type": {"enum": ["search", "recommendation", "editorial_trend"]}, "page_count": {"type": "integer", "minimum": 1, "maximum": 20}, "canvas": {"type": "object", "additionalProperties": false, "required": ["width", "height", "format"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "format": {"enum": ["png", "jpg", "webp", "svg"]}}}, "style_preset": {"type": "string"}, "user_notes": {"type": "string"}}},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["page_id", "sequence", "purpose", "text", "asset_refs"], "properties": {"page_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1}, "purpose": {"type": "string"}, "text": {"type": "array", "items": {"type": "string"}}, "asset_refs": {"type": "array", "items": {"type": "string"}}}}},
    "image_tasks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "page_id", "description", "status"], "properties": {"task_id": {"type": "string"}, "page_id": {"type": "string"}, "description": {"type": "string"}, "status": {"enum": ["pending", "ready", "blocked"]}, "provider": {"type": ["string", "null"]}}}},
    "assets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["asset_id", "kind", "synthetic", "license_status"], "properties": {"asset_id": {"type": "string"}, "kind": {"enum": ["generated", "user_supplied", "synthetic", "font", "icon"]}, "uri": {"type": ["string", "null"]}, "synthetic": {"type": "boolean"}, "license_status": {"enum": ["verified", "user_attested", "unknown", "not_applicable"]}, "credit": {"type": ["string", "null"]}}}},
    "render_outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["page_id", "path", "format", "width", "height", "sha256"], "properties": {"page_id": {"type": "string"}, "path": {"type": "string", "not": {"pattern": "^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)"}}, "format": {"enum": ["png", "jpg", "webp", "svg"]}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "renderer_version": {"type": "string"}}}},
    "qa_result": {"type": "object", "additionalProperties": false, "required": ["status", "checks", "human_visual_review"], "properties": {"status": {"enum": ["pass", "fail", "blocked"]}, "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"enum": ["pass", "fail", "warning", "blocked"]}, "message": {"type": "string"}}}}, "human_visual_review": {"enum": ["pending", "approved", "rejected"]}}},
    "production_manifest": {"type": "object", "additionalProperties": false, "required": ["manifest_version", "created_at", "contract_versions", "writing_id", "revision", "body_sha256", "page_outputs", "qa_status"], "properties": {"manifest_version": {"const": "1.0.0"}, "created_at": {"type": "string", "format": "date-time"}, "writing_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "contract_versions": {"type": "object", "additionalProperties": {"type": "string"}}, "body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "page_outputs": {"type": "array", "items": {"type": "string"}}, "qa_status": {"enum": ["pass", "fail", "blocked"]}, "generator_version": {"type": "string"}}}
  },
  "$comment": "Renderer-only layout/internal fields are intentionally excluded. Legacy page_data is not an input contract. Visual must validate approved content_ref before rendering/export."
}


